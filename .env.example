# Server
PORT=5000

# PostgreSQL Database
# --- OPTION A: Render / hosted Postgres (recommended for deployment) ---
# Paste the "Internal Database URL" from your Render Postgres dashboard here.
# If this is set, it overrides everything in OPTION B below.
DATABASE_URL=

# --- OPTION B: Local development (used only if DATABASE_URL is empty) ---
DB_USER=postgres
DB_HOST=localhost
DB_NAME=makolaonline
DB_PASSWORD=your_password_here
DB_PORT=5432

# Auth
JWT_SECRET=change_this_to_a_long_random_string

# Admin - the account that logs in with this email becomes the Admin
ADMIN_EMAIL=admin@makolaonline.com

# Your deployed site's own URL (no trailing slash) — used to build the Flutterwave
# redirect link after checkout. Locally this is http://localhost:5000.
BASE_URL=http://localhost:5000

# Flutterwave (payments) — get these from your Flutterwave Dashboard → Settings → API Keys
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
# A secret string YOU choose — set the exact same value in Flutterwave Dashboard →
# Settings → Webhooks → "Secret Hash". This is how we verify a webhook really came from Flutterwave.
FLW_WEBHOOK_HASH=choose_a_long_random_string_and_use_it_in_both_places

# Image uploads (products, banners) — free account at cloudinary.com → Dashboard shows these three
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Business settings
# Cashback % and expiry-days are now editable live in Admin Panel → Settings (stored in the
# database). CASHBACK_PERCENT below is only used as a fallback the very first time, before
# any admin setting exists.
CASHBACK_PERCENT=3

# Subscription plan prices/limits (Starter/Business/Unlimited/Employer) are defined in db.js —
# edit the `plans` array there if prices ever need to change.
