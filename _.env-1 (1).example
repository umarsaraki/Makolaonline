# Server
PORT=5000

# PostgreSQL Database
# --- OPTION A: Render / hosted Postgres (recommended for deployment) ---
# Paste the "Internal Database URL" from your Render Postgres dashboard here.
# If this is set, it overrides everything in OPTION B below.
DATABASE_URL=

# --- OPTION B: Local development (used only if DATABASE_URL is empty) ---
DB_USER=postgres
DB_HOST=localhost
DB_NAME=makolaonline
DB_PASSWORD=your_password_here
DB_PORT=5432

# Auth
JWT_SECRET=change_this_to_a_long_random_string

# Admin - the account that logs in with this email becomes the Admin
ADMIN_EMAIL=admin@makolaonline.com

# Manual Payment Details (shown to users on the Deposit screen)
MOMO_NUMBER=024xxxxxxx
MOMO_NAME=MakolaOnline Ltd
BANK_NAME=GCB Bank
BANK_ACCOUNT_NUMBER=1234567890
BANK_ACCOUNT_NAME=MakolaOnline Ltd
